@echo off
rem Переходим в папку, где лежит этот bat-файл (чтобы работало при запуске откуда угодно)
cd /d "%~dp0"

rem Запускаем сервер на Python из venv (активация не нужна — вызываем интерпретатор напрямую)
.venv\Scripts\python.exe main.py

rem Если сервер упал с ошибкой — не закрывать окно, чтобы прочитать сообщение
pause
